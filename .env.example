# Copy this file to .env and fill in your key.

# Tavily API key (https://app.tavily.com)
TAVILY_API_KEY=

# Prefer results from this country, like Google does for your location
# (full lowercase name, e.g. india, united states, united kingdom). Leave empty for worldwide.
TAVILY_COUNTRY=india

# Research model: auto (same default as the Tavily playground), pro (most thorough), mini (cheapest)
TAVILY_RESEARCH_MODEL=auto
# Report length: short, standard, long
TAVILY_RESEARCH_LENGTH=standard
# Max seconds to wait for a research report
TAVILY_RESEARCH_TIMEOUT=300
