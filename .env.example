# Copy this file to .env and fill in your keys.

# --- Tavily (web search / company profile) ---
# Get a key at https://app.tavily.com
TAVILY_API_KEY=
# Number of web results to fetch per search (1-20)
TAVILY_MAX_RESULTS=8

# Research report (like the Tavily playground "Research"):
#   mini = 4-110 credits per report, pro = 15-250 (more thorough), auto, off
TAVILY_RESEARCH_MODEL=mini
# Max seconds to wait for a research report
TAVILY_RESEARCH_TIMEOUT=300

# --- The Companies API (company data by domain) ---
# Get a token at https://www.thecompaniesapi.com  (1 credit per company found)
COMPANIES_API_KEY=

# --- Future verifiers (added one by one) ---
# DOMAIN_AGE_API_KEY=
# EMAIL_VERIFIER_API_KEY=
# PHONE_VERIFIER_API_KEY=
